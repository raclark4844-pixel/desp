# Runtime traffic: use your provider's pooled PostgreSQL URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/aps_lead_engine?sslmode=require"

# Preferred for Prisma migrations/administration: use the direct PostgreSQL URL.
# Production builds can fall back to DATABASE_URL when DIRECT_URL is not set.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/aps_lead_engine?sslmode=require"

# Required for protected internal orchestration endpoints.
# Generate a long random value and store it as an encrypted server-side secret.
APS_INTERNAL_API_KEY="replace-with-a-long-random-secret"

# Step 3 — lead source routing.
# When configured, BatchData / BatchLeads is preferred as the API-first property-data source.
BATCHDATA_API_KEY=""

# Optional supplemental public/business prospecting automation.
PHANTOMBUSTER_API_KEY=""

# PropWire remains available as a manual export/import fallback until approved API access exists.

# Step 4: Vercel sends this as Bearer auth to the scheduled source worker.
# Required for scheduled processing; internal POST endpoints use APS_INTERNAL_API_KEY.
CRON_SECRET=""

# Step 5: separate lookup token with Basic + Contact Enrichment datasets.
BATCHDATA_ENRICHMENT_API_KEY=""
# Keep false until setup, billing review, and deferred acceptance testing.
APS_ENRICHMENT_ENABLED="false"

# Prepared RPV DNC adapter only; not connected to any worker/route yet.
# Keep disabled pending FTC authorization, provider setup and explicit activation.
RPV_API_TOKEN=""
APS_RPV_DNC_ENABLED="false"

# Campaign delivery: leave all switches false until provider and compliance setup is verified.
OUTREACH_ENABLED="false"
OUTREACH_SMS_ENABLED="false"
OUTREACH_EMAIL_ENABLED="false"
OUTREACH_CALL_ENABLED="false"
OUTREACH_SMS_SETUP_VERIFIED="false"
OUTREACH_EMAIL_SETUP_VERIFIED="false"
OUTREACH_CALL_SETUP_VERIFIED="false"
OUTREACH_PUBLIC_URL="https://desp-omega.vercel.app"
OUTREACH_CUSTOMER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_VOICE_FROM=""
OUTREACH_AGENT_PHONE=""
FTC_SAN=""
FTC_ORGANIZATION_ID=""
FTC_SAN_EXPIRES_AT=""
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
OUTREACH_FROM_EMAIL=""
OUTREACH_REPLY_TO=""

# Campaign inbox. External notifications and AI are independently disabled by default.
INBOX_NOTIFICATIONS_ENABLED=false
INBOX_EMAIL_NOTIFICATIONS_VERIFIED=false
INBOX_SMS_NOTIFICATIONS_VERIFIED=false
INBOX_NOTIFICATION_FROM=
INBOX_NOTIFICATION_SMS_FROM=
# Verified receiving subdomain. Never replace your main business mailbox MX records.
INBOX_EMAIL_DOMAIN=
INBOX_AI_ENABLED=false
OPENAI_API_KEY=
INBOX_AI_MODEL=
