generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  CLOSED
}

enum UserRole {
  APS_ADMIN
  APS_OPERATOR
  CUSTOMER_ADMIN
  CUSTOMER_USER
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum TerritoryType {
  ZIP
  COUNTY
  CITY
  STATE
  CUSTOM
}

enum LeadStatus {
  NEW
  ENRICHING
  ELIGIBLE
  SUPPRESSED
  CONTACTED
  ENGAGED
  QUALIFIED
  DELIVERED
  WON
  LOST
  INVALID
}

enum ContactType {
  MOBILE
  LANDLINE
  EMAIL
  OTHER
}

enum ConsentChannel {
  SMS
  CALL
  EMAIL
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
  NOT_REQUIRED
}

enum SuppressionScope {
  GLOBAL
  CUSTOMER
  CAMPAIGN
}

enum SuppressionReason {
  DNC
  OPT_OUT
  WRONG_NUMBER
  COMPLAINT
  INVALID_CONTACT
  INTERNAL
  LEGAL
  OTHER
}

enum ConversationChannel {
  SMS
  EMAIL
  CALL
  CHAT
}

enum ConversationStatus {
  OPEN
  WAITING
  QUALIFIED
  CLOSED
  ESCALATED
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
  SUPPRESSED
}

enum QualificationStatus {
  PENDING
  IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  NEEDS_HUMAN
}

enum AppointmentStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum DeliveryStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
}

enum ProviderJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  BLOCKED
  WAITING_MANUAL
}

enum CostType {
  DATA
  ENRICHMENT
  SMS
  EMAIL
  AI
  OTHER
}

model Customer {
  billingPreference BillingPreference?
  invoices BillingInvoice[]
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  slug        String         @unique
  status      CustomerStatus @default(ACTIVE)
  websiteUrl  String?
  contactName String?
  contactEmail String?
  timezone    String         @default("America/New_York")
  profile Json?
  externalCrm String?
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  users        User[]
  campaigns    Campaign[]
  leads        Lead[]
  suppressions Suppression[]
  deliveries   Delivery[]
  costs        Cost[]
  auditEvents  AuditEvent[]

  @@index([status])
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @db.Uuid
  email      String   @unique
  name       String?
  role       UserRole
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  auditEvents AuditEvent[]

  @@index([customerId])
  @@index([role, isActive])
}

model Campaign {
  primaryAlertTargetId String? @db.Uuid
  outboundBatches OutboundBatch[]
  smsSenderId String? @db.Uuid
  smsSender SmsSender? @relation(fields: [smsSenderId], references: [id], onDelete: Restrict)
  notificationTargets NotificationTarget[]
  knowledge ReplyKnowledge[]
  id                  String         @id @default(uuid()) @db.Uuid
  customerId          String         @db.Uuid
  name                String
  industry            String
  status              CampaignStatus @default(DRAFT)
  residential         Boolean        @default(true)
  commercial          Boolean        @default(false)
  desiredLeadCount    Int?
  startAt             DateTime?      @db.Timestamptz(6)
  endAt               DateTime?      @db.Timestamptz(6)
  targetingConfig     Json           @default("{}")
  outreachConfig      Json           @default("{}")
  qualificationConfig Json           @default("{}")
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  territories   Territory[]
  campaignLeads CampaignLead[]
  conversations Conversation[]
  providerJobs  ProviderJob[]
  costs         Cost[]
  suppressions  Suppression[]
  deliveries    Delivery[]
  auditEvents   AuditEvent[]

  @@index([customerId, status])
  @@index([industry, status])
}

model Territory {
  id         String        @id @default(uuid()) @db.Uuid
  campaignId String        @db.Uuid
  type       TerritoryType
  value      String
  state      String?
  county     String?
  metadata   Json          @default("{}")
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, type, value])
  @@index([type, value])
}

model LeadSource {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  name         String
  isActive     Boolean  @default(true)
  providerType String
  config       Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  leads        Lead[]
  providerJobs ProviderJob[]
  costs        Cost[]
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  customerId    String     @db.Uuid
  leadSourceId  String?    @db.Uuid
  externalRef   String?
  identityKey   String?
  status        LeadStatus @default(NEW)
  firstName     String?
  lastName      String?
  companyName   String?
  score         Int?
  scoreReason   String?
  sourcePayload Json       @default("{}")
  firstSeenAt   DateTime   @default(now()) @db.Timestamptz(6)
  lastUpdatedAt DateTime   @updatedAt @db.Timestamptz(6)

  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leadSource     LeadSource?     @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)
  properties     Property[]
  contacts       Contact[]
  campaignLeads  CampaignLead[]
  conversations  Conversation[]
  qualifications Qualification[]
  appointments   Appointment[]
  deliveries     Delivery[]
  suppressions   Suppression[]
  costs          Cost[]
  auditEvents    AuditEvent[]

  @@unique([customerId, identityKey])
  @@index([customerId, status])
  @@index([leadSourceId, externalRef])
  @@index([score])
}

model CampaignLead {
  id         String    @id @default(uuid()) @db.Uuid
  campaignId String    @db.Uuid
  leadId     String    @db.Uuid
  enrolledAt DateTime  @default(now()) @db.Timestamptz(6)
  removedAt  DateTime? @db.Timestamptz(6)
  metadata   Json      @default("{}")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([leadId])
}

model Property {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @db.Uuid
  address1       String
  address2       String?
  city           String
  state          String
  postalCode     String
  county         String?
  propertyType   String?
  yearBuilt      Int?
  ownerOccupied  Boolean?
  estimatedValue Decimal? @db.Decimal(14, 2)
  attributes     Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([postalCode])
  @@index([county, state])
  @@index([leadId])
}

model Contact {
  outboundRecipients OutboundRecipient[]
  id              String      @id @default(uuid()) @db.Uuid
  leadId          String      @db.Uuid
  type            ContactType
  value           String
  normalizedValue String
  isPrimary       Boolean     @default(false)
  isValid         Boolean?
  carrier         String?
  metadata        Json        @default("{}")
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)

  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  consents      Consent[]
  suppressions  Suppression[]
  messages      Message[]
  conversations Conversation[]

  @@unique([leadId, type, normalizedValue])
  @@index([normalizedValue])
}

model Consent {
  id        String         @id @default(uuid()) @db.Uuid
  contactId String         @db.Uuid
  channel   ConsentChannel
  status    ConsentStatus  @default(UNKNOWN)
  source    String?
  evidence  Json           @default("{}")
  grantedAt DateTime?      @db.Timestamptz(6)
  revokedAt DateTime?      @db.Timestamptz(6)
  expiresAt DateTime?      @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, channel, status])
}

model Suppression {
  id         String            @id @default(uuid()) @db.Uuid
  scope      SuppressionScope
  reason     SuppressionReason
  customerId String?           @db.Uuid
  campaignId String?           @db.Uuid
  leadId     String?           @db.Uuid
  contactId  String?           @db.Uuid
  value      String?
  notes      String?
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime?         @db.Timestamptz(6)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([scope, reason])
  @@index([customerId])
  @@index([campaignId])
  @@index([leadId])
  @@index([contactId])
  @@index([value])
}

model Conversation {
  fromNumber String?
  replyToken String @unique @default(uuid()) @db.Uuid
  assignedTo String? @db.Uuid
  needsReply Boolean @default(false)
  campaignHold Boolean @default(false)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  replies InboxReply[]
  id         String              @id @default(uuid()) @db.Uuid
  campaignId String              @db.Uuid
  leadId     String              @db.Uuid
  contactId  String              @db.Uuid
  channel    ConversationChannel
  status     ConversationStatus  @default(OPEN)
  startedAt  DateTime            @default(now()) @db.Timestamptz(6)
  closedAt   DateTime?           @db.Timestamptz(6)
  metadata   Json                @default("{}")

  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead           Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact        Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages       Message[]
  qualifications Qualification[]

  @@index([campaignId, status])
  @@index([leadId])
  @@index([contactId])
}

model Message {
  id                String           @id @default(uuid()) @db.Uuid
  conversationId    String           @db.Uuid
  contactId         String           @db.Uuid
  provider          String?
  providerMessageId String?
  direction         MessageDirection
  status            MessageStatus
  body              String
  sentAt            DateTime?        @db.Timestamptz(6)
  receivedAt        DateTime?        @db.Timestamptz(6)
  metadata          Json             @default("{}")
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([provider, providerMessageId])
  @@index([contactId])
}

model Qualification {
  id             String              @id @default(uuid()) @db.Uuid
  leadId         String              @db.Uuid
  conversationId String?             @db.Uuid
  status         QualificationStatus @default(PENDING)
  answers        Json                @default("{}")
  score          Int?
  summary        String?
  qualifiedAt    DateTime?           @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([conversationId])
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  leadId      String            @db.Uuid
  status      AppointmentStatus @default(REQUESTED)
  scheduledAt DateTime?         @db.Timestamptz(6)
  timezone    String            @default("America/New_York")
  notes       String?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, status])
  @@index([scheduledAt])
}

model Delivery {
  id          String         @id @default(uuid()) @db.Uuid
  customerId  String         @db.Uuid
  campaignId  String         @db.Uuid
  leadId      String         @db.Uuid
  channel     String
  destination String
  status      DeliveryStatus @default(PENDING)
  deliveredAt DateTime?      @db.Timestamptz(6)
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([customerId, status])
  @@index([campaignId])
  @@index([leadId])
}

model ProviderJob {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @db.Uuid
  leadSourceId   String?           @db.Uuid
  provider       String
  jobType        String
  externalJobId  String?
  idempotencyKey String?           @unique
  attemptCount   Int               @default(0)
  nextAttemptAt  DateTime?         @db.Timestamptz(6)
  leaseToken     String?           @db.Uuid
  leaseExpiresAt DateTime?         @db.Timestamptz(6)
  receipts       SourceReceipt[]
  status         ProviderJobStatus @default(QUEUED)
  input          Json              @default("{}")
  output         Json              @default("{}")
  error          String?
  startedAt      DateTime?         @db.Timestamptz(6)
  finishedAt     DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadSource LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([provider, externalJobId])
  @@index([jobType, status, nextAttemptAt])
}

model Cost {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String?  @db.Uuid
  campaignId   String?  @db.Uuid
  leadId       String?  @db.Uuid
  leadSourceId String?  @db.Uuid
  type         CostType
  provider     String?
  amount       Decimal  @db.Decimal(12, 4)
  currency     String   @default("USD")
  quantity     Decimal? @db.Decimal(12, 4)
  metadata     Json     @default("{}")
  incurredAt   DateTime @default(now()) @db.Timestamptz(6)

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead       Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadSource LeadSource? @relation(fields: [leadSourceId], references: [id], onDelete: SetNull)

  @@index([customerId, incurredAt])
  @@index([campaignId, incurredAt])
  @@index([leadId])
  @@index([type, provider])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String?  @db.Uuid
  campaignId String?  @db.Uuid
  leadId     String?  @db.Uuid
  userId     String?  @db.Uuid
  eventType  String
  actorType  String
  actorId    String?
  payload    Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([campaignId, createdAt])
  @@index([leadId, createdAt])
  @@index([eventType, createdAt])
}

model SourceReceipt {
  id        String      @id @default(uuid()) @db.Uuid
  jobId     String      @db.Uuid
  key       String
  digest    String
  result    Json
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  job       ProviderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, key])
}

model Employee {
  id String @id @default(uuid()) @db.Uuid
  username String @unique
  email String @unique
  name String
  passwordHash String
  isAdmin Boolean @default(false)
  isActive Boolean @default(true)
  mustChangePassword Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  sessions EmployeeSession[]
}

model EmployeeSession {
  aiEnabled Boolean @default(false)
  aiDecidedAt DateTime? @db.Timestamptz(6)
  aiEnabledAt DateTime? @db.Timestamptz(6)
  aiVersion Int @default(0)
  tokenHash String @id
  employeeId String @db.Uuid
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(6)
  @@index([employeeId])
  @@index([expiresAt])
}

model LoginAttempt {
  key String @id
  attempts Int @default(1)
  windowAt DateTime @default(now()) @db.Timestamptz(6)
}

model OutboundBatch {
  smsFrom String?
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  channel ConsentChannel
  position Int @unique @default(autoincrement())
  status String @default("DRAFT")
  subject String @default("")
  body String
  mailingAddress String
  recipientTimezone String
  approvedBy String?
  approvedAt DateTime? @db.Timestamptz(6)
  queuedAt DateTime? @db.Timestamptz(6)
  createdBy String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  lastDispatchAt DateTime? @db.Timestamptz(6)
  reason String?
  recipients OutboundRecipient[]
  @@unique([campaignId, channel])
  @@index([status, position])
}

model OutboundRecipient {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  batch OutboundBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  leadId String @db.Uuid
  contactId String @db.Uuid
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)
  destination String
  status String @default("PENDING")
  reason String?
  attempts Int @default(0)
  nextAttemptAt DateTime? @db.Timestamptz(6)
  attemptedAt DateTime? @db.Timestamptz(6)
  providerId String? @unique
  bridgeStartedAt DateTime? @db.Timestamptz(6)
  messageId String? @unique @db.Uuid
  unsubscribeToken String @unique @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([batchId, destination])
  @@index([batchId, status])
}

model OutboundReservation {
  key String @id
  recipientId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model SmsSender {
  id String @id @default(uuid()) @db.Uuid
  phone String @unique
  label String
  customerId String @db.Uuid
  serviceSid String
  active Boolean @default(true)
  verifiedAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  campaigns Campaign[]
}

model InboxReceipt {
  key String @id
  channel String
  sender String
  destination String
  body String
  conversationId String? @db.Uuid
  reason String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

model InboxReply {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId String @unique @db.Uuid
  body String
  status String @default("DRAFT")
  reason String?
  createdBy String
  providerId String? @unique
  messageId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([conversationId, createdAt])
}

model NotificationTarget {
  kind String @default("EMPLOYEE")
  name String?
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  employeeId String? @db.Uuid
  channel String
  destination String
  enabled Boolean @default(true)
  confirmedAt DateTime @db.Timestamptz(6)
  jobs ReplyNotification[]
  @@unique([campaignId, employeeId, channel])
}

model ReplyNotification {
  destinationSnapshot String?
  kind String @default("REPLY")
  body String?
  id String @id @default(uuid()) @db.Uuid
  targetId String @db.Uuid
  target NotificationTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  receiptKey String
  conversationId String @db.Uuid
  status String @default("PENDING")
  reason String?
  providerId String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([targetId, receiptKey])
  @@index([status, createdAt])
}

model ReplyKnowledge {
  id String @id @default(uuid()) @db.Uuid
  campaignId String @db.Uuid
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  question String
  answer String
  approvedBy String
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([campaignId, active])
}

model AiObservation {
  id String @id @default(uuid()) @db.Uuid
  messageId String @unique @db.Uuid
  conversationId String @db.Uuid
  employeeId String @db.Uuid
  status String @default("RUNNING")
  summary String?
  question String?
  answer String?
  knowledgeStatus String @default("PENDING")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([conversationId, createdAt])
}

model BillingConfig {
  id String @id @default("main")
  thirdEmail String?
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
model BillingPreference {
  customerId String @id @db.Uuid
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade)
  email String?
  enabled Boolean @default(true)
}
model BillingInvoice {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict)
  number String @unique
